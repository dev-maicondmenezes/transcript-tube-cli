.TH "TYOT" "1" "Nov 2026" "tyot" "Manual do tyot"

.SH NAME
tyot-completion - Gera script de completion para o shell


.SH SYNOPSIS
\fBtyot completion [bash|zsh|fish|powershell] [flags]\fP


.SH DESCRIPTION
Gera um script de completion para bash, zsh, fish ou powershell.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for completion


.SH SEE ALSO
\fBtyot(1)\fP
